# Copy this file to `.env` and paste your keys after the `=` signs.
# `.env` is git-ignored, so your keys never get committed.

# https://console.groq.com  -> API Keys
GROQ_API_KEY=

# https://openrouter.ai  -> Keys
OPENROUTER_API_KEY=

# https://aistudio.google.com  -> Get API key  (optional)
GEMINI_API_KEY=

# Optional: require clients to send "Authorization: Bearer <this>" to use the gateway.
# Leave empty for local development; set it before deploying publicly.
GATEWAY_API_KEY=
